# Copy to .env.test for the test suite. Values there win; empty keys fall back to
# environment variables of the same name (that is how CI supplies them).
# The database must exist solely for tests: every run drops and recreates its tables.
# Leave TEST_MYSQL_HOST empty to skip MySQL tests.
TEST_MYSQL_HOST=
TEST_MYSQL_PORT=
TEST_MYSQL_DATABASE=
TEST_MYSQL_USERNAME=
TEST_MYSQL_PASSWORD=
