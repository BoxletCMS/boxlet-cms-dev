/vendor/
.env
.env.test
/tests/tmp/
/storage/*
!/storage/.gitkeep
!/storage/.htaccess
# Original uploads live outside the web root (D-020). The directory and its deny
# file ship: a fresh install must have somewhere to put originals, and that
# somewhere must already refuse to serve them.
!/storage/uploads/
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess
/public/cache/*
!/public/cache/.gitkeep
/public/m/*
!/public/m/.gitkeep
*.sqlite
*.sqlite-journal
.DS_Store
id_rsa*
id_ed25519*
*.pem

# Local Claude Code permissions: per-machine, never committed.
.claude/settings.local.json
