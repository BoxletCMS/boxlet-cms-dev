/vendor/
.env
.env.test
/tests/tmp/
/storage/*
!/storage/.gitkeep
!/storage/.htaccess
# Original uploads live outside the web root (D-020). The directory and its deny
# file ship: a fresh install must have somewhere to put originals, and that
# somewhere must already refuse to serve them.
!/storage/uploads/
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess
/public/cache/*
!/public/cache/.gitkeep
/public/m/*
!/public/m/.gitkeep
# Written by the site itself whenever what they list changes (PLAN.md D-049, D-151); a
# robots.txt of the owner's own is theirs, not the release's, either way.
/public/sitemap.xml
/public/robots.txt
/public/llms.txt
*.sqlite
*.sqlite-journal
.DS_Store
id_rsa*
id_ed25519*
*.pem

# Local Claude Code permissions: per-machine, never committed.
.claude/settings.local.json

# Working material the owner and I pass between ourselves — design handoffs, reviews,
# prototypes. It is how a decision was reached, not part of Boxlet; what survives of it
# belongs in PLAN.md or docs/SPEC.md in our own words.
/docs/editor_new/
/docs/design_handoff_admin_v2/
# Design sets an owner drops in over FTP (PLAN.md D-155): theirs, never the release's.
/designs/custom/

# The demo pictures' working files (PLAN.md D-207): the review sheet and its 800 px previews
# are for the owner's look, the cache saves asking the sources again. Neither ships.
/demo_images/_review.html
/demo_images/*/*-800.webp
/demo_images/.cache/
/tools/demo-images/_shots/
