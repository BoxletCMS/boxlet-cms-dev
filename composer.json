{
    "name": "zaja/boxlet",
    "description": "A small self-hosted PHP CMS for people who build many small sites.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "bacon/bacon-qr-code": "~3.1.0",
        "monolog/monolog": "~3.12.0",
        "nikic/fast-route": "~1.3.0",
        "spomky-labs/otphp": "~11.5.0",
        "symfony/mailer": "~6.4.0",
        "vlucas/phpdotenv": "~5.7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "~2.2.0"
    }
}
